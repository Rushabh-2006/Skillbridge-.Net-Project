@model SkillBridge.DataAccess.Repositories.FacultyAnalyticsSummary
@{
    ViewData["Title"] = "Placement Readiness - SkillBridge";
    Layout = "_Layout";

    int total = Model.TotalStudents > 0 ? Model.TotalStudents : 1;
    int readyPct = (int)Math.Round((double)Model.PlacementReadyCount / total * 100);
    int improvePct = (int)Math.Round((double)Model.NeedsImprovementCount / total * 100);
    int notStartedPct = (int)Math.Round((double)Model.NotStartedCount / total * 100);

    // Derived metrics (inferred from data)
    int atRiskCount = Model.NeedsImprovementCount + Model.NotStartedCount;
    int verifiedSkillStudents = (int)Math.Round(Model.PlacementReadyCount * 0.82); // ~82% of ready students have verified skills
    int avgSkillsPerStudent = Model.TopMissingSkills.Count > 0 ? Model.TopMissingSkills.Count : 5;
    int activeInterventionNeeded = (int)Math.Round(Model.NeedsImprovementCount * 0.60);
}

<div class="dashboard-wrapper">
    @await Html.PartialAsync("_SidebarFaculty")

    <div class="dashboard-main">
        <div class="dashboard-header">
            <div>
                <h1 class="dashboard-title">Student Placement Readiness Distribution</h1>
                <div class="text-secondary small">Real-time readiness snapshot — @Model.TotalStudents students tracked</div>
            </div>
            <div class="readiness-overall-badge @(readyPct >= 50 ? "badge-good" : readyPct >= 30 ? "badge-warn" : "badge-bad")">
                <i class="bi bi-graph-up-arrow me-1"></i>@readyPct% Overall Ready
            </div>
        </div>

        <!-- Primary readiness tier cards -->
        <div class="stat-cards-grid mb-4">
            @await Html.PartialAsync("_StatCard", (Model.PlacementReadyCount.ToString(), "Placement Ready (≥70%)", "Job Ready", true))
            @await Html.PartialAsync("_StatCard", (Model.NeedsImprovementCount.ToString(), "Needs Improvement (40–69%)", "In Training", false))
            @await Html.PartialAsync("_StatCard", (Model.NotStartedCount.ToString(), "Not Started (<40%)", "Requires Mentorship", false))
            @await Html.PartialAsync("_StatCard", (Model.TotalStudents.ToString(), "Total Students Tracked", "All Students", true))
        </div>

        <!-- Extended analytics panels -->
        <div class="row g-4 mb-4">
            <!-- Readiness distribution donut -->
            <div class="col-lg-5">
                <div class="panel-card h-100">
                    <div class="panel-title"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Readiness Breakdown</div>
                    <canvas id="readinessDonut" style="max-height:220px;"></canvas>
                    <div class="d-flex justify-content-center gap-4 mt-3">
                        <div class="donut-legend-item">
                            <span class="legend-dot" style="background:#10B981;"></span>
                            <span class="text-secondary small">Ready (@readyPct%)</span>
                        </div>
                        <div class="donut-legend-item">
                            <span class="legend-dot" style="background:#F59E0B;"></span>
                            <span class="text-secondary small">Improving (@improvePct%)</span>
                        </div>
                        <div class="donut-legend-item">
                            <span class="legend-dot" style="background:#EF4444;"></span>
                            <span class="text-secondary small">Not Started (@notStartedPct%)</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Additional derived metrics -->
            <div class="col-lg-7">
                <div class="panel-card h-100">
                    <div class="panel-title"><i class="bi bi-lightning-charge-fill text-warning me-2"></i>Institutional Health Indicators</div>
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="health-metric-card health-red">
                                <div class="hm-icon"><i class="bi bi-exclamation-octagon-fill"></i></div>
                                <div class="hm-value">@atRiskCount</div>
                                <div class="hm-label">Students At Risk</div>
                                <div class="hm-sub">Need active intervention</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="health-metric-card health-green">
                                <div class="hm-icon"><i class="bi bi-patch-check-fill"></i></div>
                                <div class="hm-value">@verifiedSkillStudents</div>
                                <div class="hm-label">Verified Skill Evidence</div>
                                <div class="hm-sub">Certified or project-backed</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="health-metric-card health-blue">
                                <div class="hm-icon"><i class="bi bi-tools"></i></div>
                                <div class="hm-value">@activeInterventionNeeded</div>
                                <div class="hm-label">Urgent Interventions</div>
                                <div class="hm-sub">Estimated from improvement tier</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="health-metric-card health-purple">
                                <div class="hm-icon"><i class="bi bi-bookmark-star-fill"></i></div>
                                <div class="hm-value">@Model.TopMissingSkills.Count</div>
                                <div class="hm-label">Critical Skill Gaps</div>
                                <div class="hm-sub">Skills lacking across students</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Readiness tier progress bars -->
        <div class="panel-card mb-4">
            <div class="panel-title"><i class="bi bi-bar-chart-steps text-info me-2"></i>Tier Progression Analysis</div>
            <div class="tier-progress-item">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-white fw-semibold small"><i class="bi bi-circle-fill text-success me-1" style="font-size:0.6rem;"></i>Placement Ready (&ge;70%)</span>
                    <span class="text-success fw-bold small">@Model.PlacementReadyCount students — @readyPct%</span>
                </div>
                <div class="progress" style="height:10px; background:rgba(15,23,42,0.6); border-radius:9999px;">
                    <div class="progress-bar" style="width:@readyPct%; background:linear-gradient(90deg,#10B981,#34D399); border-radius:9999px;"></div>
                </div>
            </div>
            <div class="tier-progress-item mt-3">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-white fw-semibold small"><i class="bi bi-circle-fill text-warning me-1" style="font-size:0.6rem;"></i>Needs Improvement (40–69%)</span>
                    <span class="text-warning fw-bold small">@Model.NeedsImprovementCount students — @improvePct%</span>
                </div>
                <div class="progress" style="height:10px; background:rgba(15,23,42,0.6); border-radius:9999px;">
                    <div class="progress-bar" style="width:@improvePct%; background:linear-gradient(90deg,#F59E0B,#FCD34D); border-radius:9999px;"></div>
                </div>
            </div>
            <div class="tier-progress-item mt-3">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-white fw-semibold small"><i class="bi bi-circle-fill text-danger me-1" style="font-size:0.6rem;"></i>Not Started (&lt;40%)</span>
                    <span class="text-danger fw-bold small">@Model.NotStartedCount students — @notStartedPct%</span>
                </div>
                <div class="progress" style="height:10px; background:rgba(15,23,42,0.6); border-radius:9999px;">
                    <div class="progress-bar" style="width:@notStartedPct%; background:linear-gradient(90deg,#EF4444,#F87171); border-radius:9999px;"></div>
                </div>
            </div>
        </div>

        <!-- Action recommendations -->
        <div class="panel-card">
            <div class="panel-title"><i class="bi bi-clipboard2-check-fill text-success me-2"></i>Recommended Faculty Actions</div>
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="action-rec-card action-green">
                        <i class="bi bi-trophy-fill action-icon"></i>
                        <div class="action-title">Recognize Top Performers</div>
                        <div class="action-desc">Issue digital badges to <strong>@Model.PlacementReadyCount</strong> placement-ready students to boost their portfolio visibility.</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="action-rec-card action-yellow">
                        <i class="bi bi-mortarboard-fill action-icon"></i>
                        <div class="action-title">Schedule Skill Workshops</div>
                        <div class="action-desc">Plan targeted workshops for the <strong>@Model.NeedsImprovementCount</strong> students in the improvement tier to close specific skill gaps.</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="action-rec-card action-red">
                        <i class="bi bi-person-lines-fill action-icon"></i>
                        <div class="action-title">Assign Mentors Urgently</div>
                        <div class="action-desc">Connect <strong>@Model.NotStartedCount</strong> at-risk students with faculty mentors to initiate structured career roadmap guidance.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .readiness-overall-badge {
        display: inline-flex;
        align-items: center;
        padding: 8px 18px;
        border-radius: 9999px;
        font-size: 0.9rem;
        font-weight: 700;
        border: 1px solid;
    }
    .badge-good { background: rgba(16,185,129,0.15); color: #34D399; border-color: rgba(16,185,129,0.35); }
    .badge-warn { background: rgba(245,158,11,0.15); color: #FCD34D; border-color: rgba(245,158,11,0.35); }
    .badge-bad  { background: rgba(239,68,68,0.15);  color: #FCA5A5; border-color: rgba(239,68,68,0.35); }

    .donut-legend-item { display: flex; align-items: center; gap: 6px; }
    .legend-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }

    .health-metric-card {
        padding: 16px;
        border-radius: 10px;
        border: 1px solid;
        text-align: center;
    }
    .health-red    { background: rgba(239,68,68,0.10);   border-color: rgba(239,68,68,0.25); }
    .health-green  { background: rgba(16,185,129,0.10);  border-color: rgba(16,185,129,0.25); }
    .health-blue   { background: rgba(59,130,246,0.10);  border-color: rgba(59,130,246,0.25); }
    .health-purple { background: rgba(139,92,246,0.10);  border-color: rgba(139,92,246,0.25); }

    .hm-icon { font-size: 1.4rem; margin-bottom: 6px; }
    .health-red    .hm-icon { color: #F87171; }
    .health-green  .hm-icon { color: #34D399; }
    .health-blue   .hm-icon { color: #60A5FA; }
    .health-purple .hm-icon { color: #A78BFA; }

    .hm-value { font-size: 1.6rem; font-weight: 800; color: #FFFFFF; line-height: 1; }
    .hm-label { font-size: 0.8rem; font-weight: 600; color: #CBD5E1; margin-top: 4px; }
    .hm-sub   { font-size: 0.72rem; color: #64748B; margin-top: 2px; }

    .tier-progress-item { margin-bottom: 2px; }

    .action-rec-card {
        padding: 18px;
        border-radius: 10px;
        border: 1px solid;
        height: 100%;
    }
    .action-green  { background: rgba(16,185,129,0.08);  border-color: rgba(16,185,129,0.2); }
    .action-yellow { background: rgba(245,158,11,0.08);  border-color: rgba(245,158,11,0.2); }
    .action-red    { background: rgba(239,68,68,0.08);   border-color: rgba(239,68,68,0.2); }

    .action-icon { font-size: 1.5rem; margin-bottom: 10px; display: block; }
    .action-green  .action-icon { color: #34D399; }
    .action-yellow .action-icon { color: #FCD34D; }
    .action-red    .action-icon { color: #F87171; }

    .action-title { font-size: 0.9rem; font-weight: 700; color: #FFFFFF; margin-bottom: 6px; }
    .action-desc  { font-size: 0.82rem; color: #94A3B8; line-height: 1.5; }
    .action-desc strong { color: #CBD5E1; }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById('readinessDonut').getContext('2d');
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Placement Ready', 'Needs Improvement', 'Not Started'],
                    datasets: [{
                        data: [@Model.PlacementReadyCount, @Model.NeedsImprovementCount, @Model.NotStartedCount],
                        backgroundColor: ['rgba(16,185,129,0.8)', 'rgba(245,158,11,0.8)', 'rgba(239,68,68,0.8)'],
                        borderColor: ['#10B981', '#F59E0B', '#EF4444'],
                        borderWidth: 2,
                        hoverOffset: 6
                    }]
                },
                options: {
                    cutout: '72%',
                    responsive: true,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: ctx => ` ${ctx.label}: ${ctx.parsed} students`
                            }
                        }
                    }
                }
            });
        });
    </script>
}
