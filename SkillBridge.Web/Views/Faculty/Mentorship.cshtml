@model List<SkillBridge.DataAccess.Entities.Mentorship>
@{
    ViewData["Title"] = "Faculty Mentorship - SkillBridge";
    Layout = "_Layout";
}

<div class="dashboard-wrapper">
    @await Html.PartialAsync("_SidebarFaculty")

    <div class="dashboard-main">
        <div class="dashboard-header">
            <h1 class="dashboard-title">Mentorship Request Management</h1>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success py-2">@TempData["Success"]</div>
        }

        <div class="panel-card">
            <div class="panel-title">Student Mentorship Requests</div>
            <div class="table-responsive">
                <table class="sb-table">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Topic</th>
                            <th>Status</th>
                            <th>Notes Thread</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model)
                        {
                            <tr>
                                <td class="fw-bold">@m.StudentName</td>
                                <td>@m.Topic</td>
                                <td>@await Html.PartialAsync("_StatusBadge", m.Status)</td>
                                <td class="small text-secondary">@m.Notes</td>
                                <td>
                                    <form method="post" action="/Faculty/AcceptMentorship" class="d-flex gap-2">
                                        <input type="hidden" name="mentorshipId" value="@m.Id" />
                                        <input type="text" name="notes" class="form-control form-control-sm bg-dark text-white border-secondary" placeholder="Add mentor note..." />
                                        <button type="submit" name="status" value="Active" class="btn btn-primary btn-sm font-xs">Accept/Update</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
