@model List<SkillBridge.DataAccess.Entities.Application>
@{
    ViewData["Title"] = "My Applications - SkillBridge";
    Layout = "_Layout";
}

<div class="dashboard-wrapper">
    @await Html.PartialAsync("_SidebarStudent")

    <div class="dashboard-main">
        <div class="dashboard-header">
            <h1 class="dashboard-title">My Internship Applications</h1>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success py-2">@TempData["Success"]</div>
        }

        <div class="panel-card">
            <div class="panel-title">Submitted Applications & Recruiter Auto-Decisions</div>
            <div class="table-responsive">
                <table class="sb-table">
                    <thead>
                        <tr>
                            <th>Internship Role</th>
                            <th>Company</th>
                            <th>Skill Match %</th>
                            <th>Auto Decision</th>
                            <th>Final Status</th>
                            <th>Submitted Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model)
                        {
                            <tr>
                                <td class="fw-bold">@app.InternshipTitle</td>
                                <td>@app.CompanyName</td>
                                <td>@await Html.PartialAsync("_MatchBadge", (app.MatchPercentage, app.MinimumMatchPercentage))</td>
                                <td><span class="badge bg-secondary">@app.AutoDecision</span></td>
                                <td>@await Html.PartialAsync("_StatusBadge", app.FinalDecision)</td>
                                <td class="text-secondary small">@app.DecisionDate.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
