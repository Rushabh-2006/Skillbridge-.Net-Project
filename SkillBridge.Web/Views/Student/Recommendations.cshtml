@model List<SkillBridge.DataAccess.Entities.Project>
@{
    ViewData["Title"] = "Project Recommendations - SkillBridge";
    Layout = "_Layout";
}

<div class="dashboard-wrapper">
    @await Html.PartialAsync("_SidebarStudent")

    <div class="dashboard-main">
        <div class="dashboard-header">
            <h1 class="dashboard-title">Project Recommendation Engine</h1>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success py-2">@TempData["Success"]</div>
        }

        <div class="row g-4">
            @foreach (var proj in Model)
            {
                <div class="col-md-6">
                    <div class="panel-card h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-primary text-white font-xs">@proj.Difficulty</span>
                                <span class="badge bg-success text-white font-xs">@proj.MatchPercentage% Skill Match</span>
                            </div>
                            <h3 class="fw-bold text-white fs-4 mb-2">@proj.Title</h3>
                            <p class="text-white small mb-3">@proj.Description</p>

                            @if (proj.MissingSkillNames != null && proj.MissingSkillNames.Any())
                            {
                                <div class="p-3 border border-warning border-opacity-30 bg-warning bg-opacity-10 rounded-3 mb-3">
                                    <div class="small text-warning fw-bold mb-1"><i class="bi bi-lightbulb me-1"></i>Missing Skills to Learn:</div>
                                    <div class="small text-white">@string.Join(", ", proj.MissingSkillNames)</div>
                                </div>
                            }
                        </div>

                        <!-- Upload Proof Modal Trigger -->
                        <button type="button" class="btn btn-primary w-100 mt-3 fw-bold" data-bs-toggle="modal" data-bs-target="#modalProject@(proj.Id)">
                            <i class="bi bi-upload me-2"></i>Build & Upload Project Proof
                        </button>
                    </div>

                    <!-- Modal -->
                    <div class="modal fade" id="modalProject@(proj.Id)" tabindex="-1" aria-labelledby="modalLabel@(proj.Id)" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title fw-bold text-white" id="modalLabel@(proj.Id)">Submit Proof: @proj.Title</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <form method="post" action="/Student/SubmitProject">
                                    <div class="modal-body">
                                        <input type="hidden" name="projectId" value="@proj.Id" />
                                        <div class="mb-3">
                                            <label class="form-label text-white small fw-bold">GitHub Repository URL</label>
                                            <input type="url" name="repositoryUrl" class="form-control" placeholder="https://github.com/user/project" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label text-white small fw-bold">Live Demo URL (Optional)</label>
                                            <input type="url" name="liveDemoUrl" class="form-control" placeholder="https://demo.example.com" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label text-white small fw-bold">Proof File Path / Documentation Link</label>
                                            <input type="text" name="proofFilePath" class="form-control" placeholder="/proofs/project-doc.pdf" />
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-primary fw-bold px-4">Submit Evidence</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
