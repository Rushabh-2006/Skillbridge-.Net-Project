@{
    ViewData["Title"] = "Sign In - SkillBridge";
    Layout = "_Layout";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center bg-dark py-5">
    <div class="card bg-dark text-white border-secondary shadow-lg p-4" style="max-width: 420px; width: 100%;">
        <div class="text-center mb-4">
            <a href="/" class="text-decoration-none fs-3 fw-bold text-white"><i class="bi bi-cpu-fill text-primary me-2"></i>Skill<span class="text-primary">Bridge</span></a>
            <p class="text-secondary small mt-2">Enterprise Placement Intelligence Platform</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 small">@ViewBag.Error</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success py-2 small">@TempData["Success"]</div>
        }

        <form method="post" action="/Account/Login">
            <div class="mb-3">
                <label class="form-label text-secondary small fw-bold">Email Address</label>
                <input type="email" id="loginEmail" name="email" class="form-control bg-dark text-white border-secondary" placeholder="Enter your registered email" required autocomplete="email" />
            </div>
            <div class="mb-3">
                <label class="form-label text-secondary small fw-bold">Password</label>
                <input type="password" id="loginPassword" name="password" class="form-control bg-dark text-white border-secondary" placeholder="Enter your password" required autocomplete="current-password" />
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold mb-3"><i class="bi bi-box-arrow-in-right me-1"></i> Sign In</button>
        </form>

        <div class="border-top border-secondary pt-3 mt-3">
            <div class="text-secondary small fw-bold mb-2">Registered System Credentials (Click to fill):</div>
            <div class="d-flex flex-column gap-2">
                <button type="button" class="btn btn-outline-primary btn-sm text-start d-flex justify-content-between align-items-center" onclick="fillCreds('student@skillbridge.io', 'Student@2026!')">
                    <span><span class="badge bg-primary me-2">Student</span> student@skillbridge.io</span>
                    <span class="text-secondary small">Student@2026!</span>
                </button>
                <button type="button" class="btn btn-outline-warning btn-sm text-start d-flex justify-content-between align-items-center" onclick="fillCreds('recruiter@nexuscloud.io', 'Recruiter@2026!')">
                    <span><span class="badge bg-warning text-dark me-2">Recruiter</span> recruiter@nexuscloud.io</span>
                    <span class="text-secondary small">Recruiter@2026!</span>
                </button>
                <button type="button" class="btn btn-outline-info btn-sm text-start d-flex justify-content-between align-items-center" onclick="fillCreds('faculty@stanford.edu', 'Faculty@2026!')">
                    <span><span class="badge bg-info text-dark me-2">Faculty</span> faculty@stanford.edu</span>
                    <span class="text-secondary small">Faculty@2026!</span>
                </button>
                <button type="button" class="btn btn-outline-danger btn-sm text-start d-flex justify-content-between align-items-center" onclick="fillCreds('admin@skillbridge.io', 'Admin@2026!')">
                    <span><span class="badge bg-danger me-2">Admin</span> admin@skillbridge.io</span>
                    <span class="text-secondary small">Admin@2026!</span>
                </button>
            </div>
        </div>

        <script>
            function fillCreds(email, pwd) {
                document.getElementById('loginEmail').value = email;
                document.getElementById('loginPassword').value = pwd;
            }
        </script>

        <div class="text-center mt-4">
            <a href="/Account/Register" class="text-primary small text-decoration-none">Don't have an account? Register here</a>
        </div>
    </div>
</div>
